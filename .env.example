# ==============================================================================
# AR Tours WhatsApp Customer Care Agent — Environment Configuration Reference
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
SELF_PING_URL=https://ar-tours-agent.onrender.com

# Meta WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
PHONE_NUMBER_ID=your_primary_phone_number_id_here
SECOND_PHONE_NUMBER_ID=your_secondary_phone_number_id_here
WHATSAPP_GRAPH_VERSION=v21.0
WEBHOOK_VERIFY_TOKEN=ar_tours_secure_2026
WEBHOOK_SECRET=ar_tours_webhook_secret_2026

# Supabase (PostgreSQL & Object Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_MEDIA_BUCKET=whatsapp-media
OPERATOR_ID=ar_tours

# AI Providers (At least one must be set; automatic fallback order: Claude -> Gemini -> Groq)
CLAUDE_API_KEY=your_claude_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Web Inbox Authentication & PWA Push Notifications
INBOX_USER=artours
INBOX_PASS=your_strong_inbox_password_here
INBOX_URL=https://ar-tours-agent.onrender.com/inbox
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Bokun Booking Webhook Integration
BOKUN_SECRET_KEY=your_bokun_webhook_hmac_secret_key_here

# Alert Notifications (Optional - HTTPS Google Apps Script is recommended over SMTP)
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
APPS_SCRIPT_SECRET=your_apps_script_shared_secret_here
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_TO=
